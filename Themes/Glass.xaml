<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Glass theme: translucent dark surface with a thin bright border. -->
    <sys:Boolean x:Key="AttachTop">False</sys:Boolean>
    <Thickness x:Key="IslandTopMargin">0,8,0,0</Thickness>

    <LinearGradientBrush x:Key="IslandBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D918181C" Offset="0" />
        <GradientStop Color="#E60E0E12" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#2EFFFFFF" />
    <Thickness x:Key="IslandBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#34C759" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2EFFFFFF" />

</ResourceDictionary>
