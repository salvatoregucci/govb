<Window x:Class="DynamicIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" Width="580" Height="300"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="Island"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="{DynamicResource IslandTopMargin}"
            Background="{DynamicResource IslandBackgroundBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="{DynamicResource IslandBorderThickness}"
            Width="170" Height="40" CornerRadius="20"
            AllowDrop="True"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel"
            DragEnter="Island_DragEnter" DragOver="Island_DragOver" Drop="Island_Drop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.35" />
        </Border.Effect>

        <Grid ClipToBounds="True">

            <!-- Top glow tinted with the album-art accent colour. -->
            <Border x:Name="TintOverlay" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1.15">
                        <GradientStop x:Name="TintStop" Color="#0034C759" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- ======== COMPACT PILL VIEW ======== -->
            <Grid x:Name="PillView" Height="40" VerticalAlignment="Top" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PillClock" Text="--:--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- Local microphone/headphone state while in a Discord voice channel. -->
                    <Border x:Name="PillMuteIcon" Width="16" Height="16" CornerRadius="8"
                            Background="#ED4245" Margin="7,0,0,0" Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <Grid>
                            <Border Width="5" Height="8" CornerRadius="2.5" Background="White"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Line X1="3" Y1="3" X2="13" Y2="13" Stroke="White"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Image x:Name="PillAppIcon" Grid.Column="1" Width="17" Height="17"
                       Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock x:Name="PillTitle" Grid.Column="2" Margin="8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Visibility="Collapsed" />

                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <StackPanel x:Name="PillBarsPanel" Orientation="Horizontal"
                                Height="16" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Ellipse x:Name="PillDot" Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <!-- Avatar of the Discord speaker or recent joiner (green ring = speaking). -->
                    <Border x:Name="PillDiscordAvatar" Width="22" Height="22" CornerRadius="11"
                            BorderBrush="#34C759" BorderThickness="2" Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush x:Name="PillDiscordBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <!-- Persistent Discord badge when in a voice channel with no active speaker. -->
                    <Border x:Name="PillDiscordLogo" Width="18" Height="18" Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <Path Fill="#5865F2" Stretch="Uniform">
                            <Path.Data>
                                <CombinedGeometry GeometryCombineMode="Exclude">
                                    <CombinedGeometry.Geometry1>
                                        <RectangleGeometry Rect="0,0,18,18" RadiusX="8" RadiusY="6" />
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <GeometryGroup>
                                            <EllipseGeometry Center="6.4,9.4" RadiusX="1.7" RadiusY="2.4" />
                                            <EllipseGeometry Center="11.6,9.4" RadiusX="1.7" RadiusY="2.4" />
                                        </GeometryGroup>
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </Path.Data>
                        </Path>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======== EXPANDED PANEL (view pager) ======== -->
            <Grid x:Name="ExpandedView" Width="520" Height="238"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
                <Grid Margin="24,14,24,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top: clock and view name/presence. -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="BigClock" Text="--:--"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="26" FontWeight="Light" VerticalAlignment="Center" />
                            <TextBlock x:Name="BigDate" Text="—" Margin="12,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                                       VerticalAlignment="Center" />

                            <!-- PC battery: body, terminal, percentage, and charging icon. -->
                            <StackPanel x:Name="HeaderBattery" Orientation="Horizontal"
                                        Margin="14,4,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Width="21" Height="11" CornerRadius="3"
                                        BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"
                                        Padding="1" VerticalAlignment="Center">
                                    <Border x:Name="HeadBatFill" Background="#34C759" CornerRadius="1.5"
                                            HorizontalAlignment="Left" Width="10" />
                                </Border>
                                <Border Width="2" Height="5" Margin="1,0,0,0" CornerRadius="0,1.5,1.5,0"
                                        Background="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeadBatText" Text="--%" FontSize="11.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ViewTitle" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                            <StackPanel x:Name="PresenceBadge" Orientation="Horizontal"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse x:Name="PresenceDot" Width="7" Height="7"
                                         VerticalAlignment="Center" Fill="#34C759" />
                                <TextBlock x:Name="PresenceText" Margin="6,0,0,0" FontSize="11.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Centre: switchable views. -->
                    <Grid x:Name="ViewHost" Grid.Row="1" ClipToBounds="True" Margin="0,10,0,0">

                        <!-- 1) MEDIA -->
                        <Grid x:Name="ViewMedia">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="18" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                                        <Border x:Name="MediaArtFallback" CornerRadius="12" Background="#2C2C2E">
                                            <TextBlock Text="♪" FontSize="24" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border CornerRadius="12">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,56,56" RadiusX="12" RadiusY="12" />
                                            </Border.Clip>
                                            <Image x:Name="MediaArt" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Border x:Name="MediaAppIconHolder" Width="22" Height="22" CornerRadius="6"
                                                Background="#0A0A0C" HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom" Margin="0,0,-5,-5"
                                                Visibility="Collapsed">
                                            <Image x:Name="MediaAppIcon" Width="15" Height="15"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MediaTitle" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MediaArtist" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid x:Name="ProgressTrack" Height="4" Margin="0,9,0,0">
                                            <Border Background="{DynamicResource ProgressTrackBrush}" CornerRadius="2" />
                                            <Border x:Name="ProgressFill" Background="{DynamicResource TextPrimaryBrush}"
                                                    CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        </Grid>
                                        <Grid x:Name="TimeRow" Margin="0,4,0,0">
                                            <TextBlock x:Name="MediaPosText" Text="0:00" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock x:Name="MediaDurText" Text="0:00" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnPrev" Style="{StaticResource IconButton}"
                                                Content="&#xE892;" Click="BtnPrev_Click" />
                                        <Button x:Name="BtnPlay" Style="{StaticResource IconButton}"
                                                Content="&#xE768;" FontSize="17" Click="BtnPlay_Click" />
                                        <Button x:Name="BtnNext" Style="{StaticResource IconButton}"
                                                Content="&#xE893;" Click="BtnNext_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2) CALENDAR -->
                        <Grid x:Name="ViewCalendar" Visibility="Collapsed">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="18" Padding="14,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Button x:Name="BtnCalPrev" Style="{StaticResource IconButton}"
                                                Width="24" Height="24" FontSize="9" Content="&#xE76B;"
                                                HorizontalAlignment="Left" Click="BtnCalPrev_Click" />
                                        <TextBlock x:Name="CalMonthLabel" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Button x:Name="BtnCalNext" Style="{StaticResource IconButton}"
                                                Width="24" Height="24" FontSize="9" Content="&#xE76C;"
                                                HorizontalAlignment="Right" Click="BtnCalNext_Click" />
                                    </Grid>
                                    <UniformGrid x:Name="CalDayNames" Grid.Row="1" Columns="7" Margin="0,2,0,2" />
                                    <UniformGrid x:Name="CalGrid" Grid.Row="2" Columns="7" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3) FILE TRAY -->
                        <Grid x:Name="ViewTray" Visibility="Collapsed">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="18" Padding="10,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TrayEmptyText" Grid.Row="0"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                                        <WrapPanel x:Name="TrayPanel" HorizontalAlignment="Center" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="TrayTipText" Grid.Row="1" FontSize="9.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,2" Opacity="0.7" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 4) BLUETOOTH -->
                        <Grid x:Name="ViewBt" Visibility="Collapsed">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="18" Padding="16,8">
                                <Grid>
                                    <TextBlock x:Name="BtEmptyText" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                        <StackPanel x:Name="BtPanel" VerticalAlignment="Center" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 5) DISCORD VOICE CHANNEL -->
                        <Grid x:Name="ViewDiscord" Visibility="Collapsed">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="18" Padding="14,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel x:Name="DiscordChannelHeader" Grid.Row="0" Orientation="Horizontal"
                                                Margin="2,0,0,6" Visibility="Collapsed">
                                        <Border Width="16" Height="16">
                                            <Path Fill="#5865F2" Stretch="Uniform">
                                                <Path.Data>
                                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                                        <CombinedGeometry.Geometry1>
                                                            <RectangleGeometry Rect="0,0,18,18" RadiusX="8" RadiusY="6" />
                                                        </CombinedGeometry.Geometry1>
                                                        <CombinedGeometry.Geometry2>
                                                            <GeometryGroup>
                                                                <EllipseGeometry Center="6.4,9.4" RadiusX="1.7" RadiusY="2.4" />
                                                                <EllipseGeometry Center="11.6,9.4" RadiusX="1.7" RadiusY="2.4" />
                                                            </GeometryGroup>
                                                        </CombinedGeometry.Geometry2>
                                                    </CombinedGeometry>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11.5">
                                            <Run x:Name="DiscordChannelName" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Run x:Name="DiscordGuildName" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="DiscordEmptyText" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                            <WrapPanel x:Name="DiscordPanel" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom: view navigation dots. -->
                    <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,7,0,2" />
                </Grid>
            </Grid>

            <!-- ======== iOS-STYLE NOTIFICATION ======== -->
            <Grid x:Name="NotifView" Width="420" Height="100"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="#2C2C2E" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifAppInitial" Text="!" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NotifAppName" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="NotifTime" FontSize="10.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="NotifTitle" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotifBody" FontSize="12" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
